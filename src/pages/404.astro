---
import "../global.css";
import SeoHead from "../components/SeoHead.astro";
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <SeoHead path="/404" noindex={true} title="Page not found — Muhammad Saad" description="The page you requested does not exist. Return to Muhammad Saad's portfolio homepage." />
    <noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-glow focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:text-void">Skip to content</a>
    <main id="main" class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-6 text-center">
      <p class="font-mono text-sm text-dim">$ 404 — no_such_route</p>
      <h1 class="mt-4 font-mono text-3xl font-bold text-slate-100">Page not found</h1>
      <p class="mt-3 max-w-md text-body text-fog">The route you requested doesn't exist. Head back to the homepage to browse selected work, stack, and contact.</p>
      <a href="/" class="btn-accent mt-7 px-5 py-2.5">← Back to homepage</a>
    </main>
  </body>
</html>
