---
import experience from "../data/experience.json";
import SectionHeading from "./SectionHeading.astro";
---
<section id="experience" aria-label="Work experience" class="section-shell py-14">
  <SectionHeading index="05" prefix={experience.prefix} title={experience.heading} />
  <div class="relative ml-2 border-l border-edge pl-6">
    {experience.items.map((e) => (
      <div class="reveal relative pb-8 last:pb-0">
        <span class="absolute -left-8 top-1 size-2.5 rounded-full border border-glow bg-void" aria-hidden="true"></span>
        <p class="font-mono text-micro text-glow">
          <time datetime={(e as Record<string, string>).startISO || undefined}>{e.start}</time>
          {" → "}
          {(e as Record<string, string>).endISO
            ? <time datetime={(e as Record<string, string>).endISO}>{e.end}</time>
            : <span>{e.end}</span>}
        </p>
        <h3 class="mt-1 font-mono text-body font-semibold text-slate-100">{e.company}</h3>
        <p class="font-mono text-code text-fog">{e.role}</p>
        {e.note && <p class="mt-2 max-w-3xl text-body-sm leading-relaxed text-slate-400">{e.note}</p>}
      </div>
    ))}
  </div>
</section>
