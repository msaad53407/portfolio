---
import about from "../data/about.json";
import SectionHeading from "./SectionHeading.astro";
---
<section id="about" aria-label="About Muhammad Saad" class="section-shell py-14">
  <SectionHeading index="01" prefix={about.prefix} title={about.heading} />
  <div class="reveal panel p-6">
    <p class="font-mono text-micro text-dim">$ whoami</p>
    <p class="mt-3 max-w-3xl text-body leading-relaxed text-slate-300">{about.body}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {about.pills.map((p) => (
        <span class="tag-pill">
          {p}
        </span>
      ))}
    </div>
  </div>
</section>
